@inherits LayoutComponentBase

<a href="#main" class="sr-only focus:not-sr-only focus:absolute focus:left-0 focus:top-0 focus:z-50 focus:m-2 focus:rounded focus:bg-brand focus:px-4 focus:py-2 focus:text-white">Skip to content</a>

<header class="sticky top-0 z-40 border-b border-slate-200 bg-white/90 backdrop-blur">
    <div class="container-site flex h-[68px] items-center justify-between">
        <a href="/" class="flex items-center gap-2 text-lg font-bold text-slate-900" aria-label="ProManager Online — home">
            <svg class="h-8 w-8" viewBox="0 0 64 64" aria-hidden="true" focusable="false">
                <rect width="64" height="64" rx="14" fill="#4f46e5" />
                <path d="M20 44V20h11a8 8 0 0 1 0 16h-5v8z" fill="#fff" />
                <circle cx="44" cy="22" r="4" fill="#06b6d4" />
            </svg>
            <span>ProManager<span class="text-brand">Online</span></span>
        </a>

        <button id="nav-toggle" type="button" aria-controls="mobile-nav" aria-expanded="false"
                class="inline-flex h-10 w-10 items-center justify-center rounded-lg text-slate-700 hover:bg-slate-100 md:hidden">
            <span class="sr-only">Toggle navigation</span>
            <svg class="h-6 w-6" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16" />
            </svg>
        </button>

        <nav aria-label="Primary" class="hidden items-center gap-6 text-sm font-medium text-slate-700 md:flex">
            <AuthorizeView>
                @* Signed-in admin: the nav points at the editors and hides the public marketing links. *@
                <Authorized>
                    <a class="hover:text-brand" href="/admin/products">Products</a>
                    <a class="hover:text-brand" href="/admin/docs">Docs</a>
                    <a class="hover:text-brand" href="/admin/about">About</a>
                    <form method="post" action="/Admin/Account/Logout" class="contents">
                        <AntiforgeryToken />
                        <button type="submit" class="btn-primary">Sign out</button>
                    </form>
                </Authorized>
                <NotAuthorized>
                    <a class="hover:text-brand" href="/products">Products</a>
                    <a class="hover:text-brand" href="/services">Services</a>
                    <a class="hover:text-brand" href="/pricing">Pricing</a>
                    <a class="hover:text-brand" href="/docs">Docs</a>
                    <a class="hover:text-brand" href="/about">About</a>
                    <a class="hover:text-brand" href="https://app.promanageronline.com">Customer Portal</a>
                    <a class="hover:text-brand" href="/Admin/Account/Login">Sign in</a>
                    <a class="btn-primary" href="/contact">Contact</a>
                </NotAuthorized>
            </AuthorizeView>
        </nav>
    </div>

    <nav id="mobile-nav" aria-label="Primary" class="hidden border-t border-slate-200 bg-white md:hidden">
        <div class="container-site flex flex-col gap-1 py-3 text-slate-700">
            <AuthorizeView>
                @* Signed-in admin: the nav points at the editors and hides the public marketing links. *@
                <Authorized>
                    <a class="rounded px-2 py-2 hover:bg-slate-100" href="/admin/products">Products</a>
                    <a class="rounded px-2 py-2 hover:bg-slate-100" href="/admin/docs">Docs</a>
                    <a class="rounded px-2 py-2 hover:bg-slate-100" href="/admin/about">About</a>
                    <form method="post" action="/Admin/Account/Logout">
                        <AntiforgeryToken />
                        <button type="submit" class="btn-primary mt-2 self-start">Sign out</button>
                    </form>
                </Authorized>
                <NotAuthorized>
                    <a class="rounded px-2 py-2 hover:bg-slate-100" href="/products">Products</a>
                    <a class="rounded px-2 py-2 hover:bg-slate-100" href="/services">Services</a>
                    <a class="rounded px-2 py-2 hover:bg-slate-100" href="/pricing">Pricing</a>
                    <a class="rounded px-2 py-2 hover:bg-slate-100" href="/docs">Docs</a>
                    <a class="rounded px-2 py-2 hover:bg-slate-100" href="/about">About</a>
                    <a class="rounded px-2 py-2 hover:bg-slate-100" href="https://app.promanageronline.com">Customer Portal</a>
                    <a class="rounded px-2 py-2 hover:bg-slate-100" href="/Admin/Account/Login">Sign in</a>
                    <a class="btn-primary mt-2 self-start" href="/contact">Contact</a>
                </NotAuthorized>
            </AuthorizeView>
        </div>
    </nav>
</header>

<main id="main" class="flex-1">
    @Body
</main>

<footer class="mt-auto border-t border-slate-200 bg-slate-50">
    <div class="container-site grid gap-8 py-12 sm:grid-cols-2 lg:grid-cols-4">
        <div>
            <a href="/" class="flex items-center gap-2 font-bold text-slate-900">
                <svg class="h-7 w-7" viewBox="0 0 64 64" aria-hidden="true"><rect width="64" height="64" rx="14" fill="#4f46e5" /><path d="M20 44V20h11a8 8 0 0 1 0 16h-5v8z" fill="#fff" /><circle cx="44" cy="22" r="4" fill="#06b6d4" /></svg>
                <span>ProManager<span class="text-brand">Online</span></span>
            </a>
            <p class="mt-3 text-sm text-slate-600">Subscription business software and custom application development.</p>
            <p class="mt-2 text-sm"><a class="text-brand-dark hover:underline" href="mailto:support@promanageronline.com">support@promanageronline.com</a></p>
        </div>
        <nav aria-label="Products">
            <h3 class="text-sm font-semibold text-slate-900">Products</h3>
            <ul class="mt-3 space-y-2 text-sm text-slate-600">
                <li><a class="hover:text-brand" href="/workflows">Workflows.AI</a></li>
                <li><a class="hover:text-brand" href="/air-compliance">Air Compliance</a></li>
                <li><a class="hover:text-brand" href="/products">All products</a></li>
                <li><a class="hover:text-brand" href="/pricing">Pricing</a></li>
            </ul>
        </nav>
        <nav aria-label="Company">
            <h3 class="text-sm font-semibold text-slate-900">Company</h3>
            <ul class="mt-3 space-y-2 text-sm text-slate-600">
                <li><a class="hover:text-brand" href="/about">About</a></li>
                <li><a class="hover:text-brand" href="/services">Services</a></li>
                <li><a class="hover:text-brand" href="/docs">Documentation</a></li>
                <li><a class="hover:text-brand" href="/contact">Contact</a></li>
            </ul>
        </nav>
        <nav aria-label="Legal">
            <h3 class="text-sm font-semibold text-slate-900">Legal</h3>
            <ul class="mt-3 space-y-2 text-sm text-slate-600">
                <li><a class="hover:text-brand" href="/terms">Terms of Service</a></li>
                <li><a class="hover:text-brand" href="/privacy">Privacy Policy</a></li>
                <li><a class="hover:text-brand" href="/refunds">Refunds &amp; Cancellation</a></li>
            </ul>
        </nav>
    </div>
    <div class="border-t border-slate-200">
        <div class="container-site flex flex-col gap-1 py-4 text-xs text-slate-500 sm:flex-row sm:justify-between">
            <span>&copy; 2026 ProManager Online. Operated by [Owner Name], an independent sole proprietor.</span>
            <span>promanageronline.com</span>
        </div>
    </div>
</footer>
