<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <base href="/" />
    <meta name="theme-color" content="#4f46e5" />
    <link rel="icon" href="favicon.svg" type="image/svg+xml" />
    <ResourcePreloader />
    <link rel="stylesheet" href="@Assets["css/app.css"]" />
    <link rel="stylesheet" href="@Assets["ProManagerOnline.Site.Web.styles.css"]" />
    <ImportMap />
    <HeadOutlet />
</head>
<body class="flex min-h-screen flex-col bg-white font-sans text-slate-900 antialiased">
    <Routes />
    <script src="@Assets["_framework/blazor.web.js"]"></script>
    <script>
        // Delegated mobile-nav toggle — survives Blazor enhanced navigation (no per-page re-binding).
        document.addEventListener('click', function (e) {
            var btn = e.target.closest ? e.target.closest('#nav-toggle') : null;
            if (!btn) return;
            var menu = document.getElementById('mobile-nav');
            if (!menu) return;
            var open = menu.classList.toggle('hidden') === false;
            btn.setAttribute('aria-expanded', open ? 'true' : 'false');
        });
    </script>
</body>
</html>
