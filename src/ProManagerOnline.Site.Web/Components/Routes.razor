<Router AppAssembly="typeof(App).Assembly"
        AdditionalAssemblies="new[] { typeof(ProManagerOnline.Site.Web.Client.Services.IDocsAdminApi).Assembly }">
    <Found Context="routeData">
        <RouteView RouteData="routeData" DefaultLayout="typeof(AdminLayout)" />
        <FocusOnNavigate RouteData="routeData" Selector="h1" />
    </Found>
    <NotFound>
        <LayoutView Layout="typeof(AdminLayout)">
            <div class="container-site py-16 text-center">
                <h1 class="text-2xl font-bold text-slate-900">Page not found</h1>
                <p class="mt-2 text-slate-600">There's nothing at this address.</p>
            </div>
        </LayoutView>
    </NotFound>
</Router>
