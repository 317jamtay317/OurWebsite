@page "/docs/{productId:guid}/{pageName?}"
@model ArticleModel
@{
    ViewData["Title"] = Model.Article is null
        ? $"{Model.Navigation.ProductName} documentation"
        : Model.Article.Title;
}

<div class="container-site py-8">
    <nav aria-label="Breadcrumb" class="mb-6 text-sm text-slate-500">
        <ol class="flex flex-wrap items-center gap-1.5">
            <li><a class="hover:text-brand" href="/docs">Docs</a></li>
            <li aria-hidden="true">/</li>
            <li>
                <a class="hover:text-brand" href="/docs/@Model.Navigation.ProductId">@Model.Navigation.ProductName</a>
            </li>
            @if (Model.Article is not null)
            {
                <li aria-hidden="true">/</li>
                <li class="font-medium text-slate-700" aria-current="page">@Model.Article.Title</li>
            }
        </ol>
    </nav>

    <div class="grid gap-8 lg:grid-cols-[16rem_minmax(0,1fr)]">
        <aside class="lg:sticky lg:top-[84px] lg:self-start" aria-label="Documentation navigation">
            <details open>
                <summary class="mb-2 cursor-pointer list-none rounded-md bg-slate-100 px-3 py-2 text-sm font-semibold text-slate-900 lg:hidden">
                    Documentation menu
                </summary>
                <partial name="_DocsSidebar" model="Model" />
            </details>
        </aside>

        <article class="min-w-0">
            @if (Model.Article is null)
            {
                <h1 class="text-3xl font-bold tracking-tight text-slate-900">@(Model.Navigation.ProductName) documentation</h1>
                <p class="mt-3 text-lg text-slate-600">Choose a topic from the list below or the menu to begin.</p>

                <div class="mt-8 space-y-8">
                    @foreach (var docSection in Model.Navigation.Sections)
                    {
                        <section>
                            <h2 class="text-sm font-semibold uppercase tracking-wide text-slate-500">@docSection.Section</h2>
                            <ul class="mt-3 space-y-2">
                                @foreach (var article in docSection.Articles)
                                {
                                    <li>
                                        <a class="font-medium text-brand hover:underline"
                                           href="/docs/@Model.Navigation.ProductId/@article.Slug">@article.Title</a>
                                    </li>
                                }
                            </ul>
                        </section>
                    }
                </div>
            }
            else
            {
                <p class="text-sm font-semibold uppercase tracking-wide text-brand">@Model.Article.Section</p>
                <div class="doc-content mt-2">
                    @Model.ArticleHtml
                </div>
            }
        </article>
    </div>
</div>
