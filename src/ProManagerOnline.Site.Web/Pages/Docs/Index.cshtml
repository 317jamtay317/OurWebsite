@page "/docs"
@model IndexModel
@{
    ViewData["Title"] = "Documentation";
}

<section class="border-b border-slate-200 bg-gradient-to-b from-brand-light/60 to-white">
    <div class="container-site py-12">
        <span class="badge mb-3">Documentation</span>
        <h1 class="text-3xl font-bold tracking-tight text-slate-900 sm:text-4xl">Product documentation</h1>
        <p class="mt-3 max-w-2xl text-lg text-slate-600">
            Guides and how-tos for getting the most out of our products. Choose a product to start reading.
        </p>
    </div>
</section>

<section class="container-site py-10">
    @if (Model.Products.Count == 0)
    {
        <p class="text-slate-600">Documentation is coming soon.</p>
    }
    else
    {
        <div class="grid gap-6 md:grid-cols-2">
            @foreach (var product in Model.Products)
            {
                <a class="card flex flex-col transition hover:shadow-card-lg" href="/docs/@product.ProductId">
                    <h2 class="text-2xl font-bold text-slate-900">@product.ProductName</h2>
                    <p class="mt-2 flex-1 text-slate-600">@product.Summary</p>
                    <span class="mt-4 text-sm font-semibold text-brand">
                        @product.ArticleCount @(product.ArticleCount == 1 ? "article" : "articles") &rarr;
                    </span>
                </a>
            }
        </div>
    }
</section>
