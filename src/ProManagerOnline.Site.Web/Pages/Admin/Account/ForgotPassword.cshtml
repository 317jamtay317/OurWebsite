@page
@model ProManagerOnline.Site.Web.Pages.Admin.Account.ForgotPasswordModel
@{
    ViewData["Title"] = "Forgot password";
}

<div class="container-site flex justify-center py-12 sm:py-16">
    <div class="card w-full max-w-md">
        @if (Model.RequestHandled)
        {
            <h1 class="text-xl font-bold text-slate-900">Check your email</h1>
            <p class="mt-2 text-sm text-slate-600">
                If an admin account exists for that address, we've sent a password reset link.
                In development the link is also written to the application log.
            </p>
            <a class="btn-secondary mt-6 inline-flex" asp-page="./Login">Back to sign in</a>
        }
        else
        {
            <h1 class="text-xl font-bold text-slate-900">Forgot your password?</h1>
            <p class="mt-1 text-sm text-slate-600">Enter your admin email and we'll send a reset link.</p>

            <form method="post" class="mt-6 space-y-4">
                @if (!ViewData.ModelState.IsValid)
                {
                    <div asp-validation-summary="All" class="rounded-md bg-red-50 p-3 text-sm text-red-700"></div>
                }
                <div>
                    <label asp-for="Input.Email" class="label">Email</label>
                    <input asp-for="Input.Email" class="input" autocomplete="username" autofocus />
                </div>
                <button type="submit" class="btn-primary w-full">Send reset link</button>
            </form>
        }
    </div>
</div>
