@page
@model ProManagerOnline.Site.Web.Pages.Admin.Account.LoginModel
@{
    ViewData["Title"] = "Sign in";
}

<div class="container-site flex justify-center py-12 sm:py-16">
    <div class="card w-full max-w-md">
        <h1 class="text-xl font-bold text-slate-900">Admin sign in</h1>
        <p class="mt-1 text-sm text-slate-600">Sign in to manage ProManager Online.</p>

        <form method="post" class="mt-6 space-y-4">
            <input type="hidden" asp-for="ReturnUrl" />

            @if (!ViewData.ModelState.IsValid)
            {
                <div asp-validation-summary="All" class="rounded-md bg-red-50 p-3 text-sm text-red-700"></div>
            }

            <div>
                <label asp-for="Input.Email" class="label">Email</label>
                <input asp-for="Input.Email" class="input" autocomplete="username" autofocus />
            </div>

            <div>
                <label asp-for="Input.Password" class="label">Password</label>
                <input asp-for="Input.Password" class="input" autocomplete="current-password" />
            </div>

            <div class="flex items-center justify-between">
                <label class="flex items-center gap-2 text-sm text-slate-700">
                    <input asp-for="Input.RememberMe" class="h-4 w-4 rounded border-slate-300 text-brand focus:ring-brand/30" />
                    Remember me
                </label>
                <a class="text-sm font-medium text-brand hover:text-brand-dark" asp-page="./ForgotPassword">Forgot password?</a>
            </div>

            <button type="submit" class="btn-primary w-full">Sign in</button>
        </form>
    </div>
</div>
