@page
@model ProManagerOnline.Site.Web.Pages.Admin.Account.ResetPasswordModel
@{
    ViewData["Title"] = "Reset password";
}

<div class="container-site flex justify-center py-12 sm:py-16">
    <div class="card w-full max-w-md">
        @if (Model.Succeeded)
        {
            <h1 class="text-xl font-bold text-slate-900">Password reset</h1>
            <p class="mt-2 text-sm text-slate-600">Your password has been reset. You can now sign in with it.</p>
            <a class="btn-primary mt-6 inline-flex" asp-page="./Login">Go to sign in</a>
        }
        else
        {
            <h1 class="text-xl font-bold text-slate-900">Reset your password</h1>
            <p class="mt-1 text-sm text-slate-600">Choose a new password for your admin sign-in.</p>

            <form method="post" class="mt-6 space-y-4">
                <input type="hidden" asp-for="Input.Email" />
                <input type="hidden" asp-for="Input.Token" />

                @if (!ViewData.ModelState.IsValid)
                {
                    <div asp-validation-summary="All" class="rounded-md bg-red-50 p-3 text-sm text-red-700"></div>
                }
                <div>
                    <label asp-for="Input.Password" class="label">New password</label>
                    <input asp-for="Input.Password" class="input" autocomplete="new-password" autofocus />
                </div>
                <div>
                    <label asp-for="Input.ConfirmPassword" class="label">Confirm password</label>
                    <input asp-for="Input.ConfirmPassword" class="input" autocomplete="new-password" />
                </div>
                <button type="submit" class="btn-primary w-full">Set new password</button>
            </form>
        }
    </div>
</div>
