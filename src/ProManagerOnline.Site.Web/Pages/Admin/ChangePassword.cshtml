@page
@model ProManagerOnline.Site.Web.Pages.Admin.ChangePasswordModel
@{
    ViewData["Title"] = "Change password";
}

<div class="container-site flex justify-center py-12 sm:py-16">
    <div class="card w-full max-w-md">
        <h1 class="text-xl font-bold text-slate-900">Change password</h1>
        <p class="mt-1 text-sm text-slate-600">Update the password for your admin sign-in.</p>

        @if (!string.IsNullOrEmpty(Model.StatusMessage))
        {
            <div class="mt-4 rounded-md bg-green-50 p-3 text-sm text-green-700">@Model.StatusMessage</div>
        }

        <form method="post" class="mt-6 space-y-4">
            @if (!ViewData.ModelState.IsValid)
            {
                <div asp-validation-summary="All" class="rounded-md bg-red-50 p-3 text-sm text-red-700"></div>
            }

            <div>
                <label asp-for="Input.CurrentPassword" class="label">Current password</label>
                <input asp-for="Input.CurrentPassword" class="input" autocomplete="current-password" />
            </div>
            <div>
                <label asp-for="Input.NewPassword" class="label">New password</label>
                <input asp-for="Input.NewPassword" class="input" autocomplete="new-password" />
            </div>
            <div>
                <label asp-for="Input.ConfirmPassword" class="label">Confirm new password</label>
                <input asp-for="Input.ConfirmPassword" class="input" autocomplete="new-password" />
            </div>

            <div class="flex items-center gap-3">
                <button type="submit" class="btn-primary">Change password</button>
                <a class="btn-ghost" asp-page="/Admin/Index">Cancel</a>
            </div>
        </form>
    </div>
</div>
