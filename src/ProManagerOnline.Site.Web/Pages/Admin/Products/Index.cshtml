@page
@using ProManagerOnline.Site.Domain.Products
@model IndexModel
@{
    ViewData["Title"] = "Products admin";
}

<section class="container-site py-10">
    <div class="flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">
        <div>
            <h1 class="text-3xl font-bold tracking-tight text-slate-900">Products</h1>
            <p class="mt-1 text-slate-600">Create and manage the products in your catalogue.</p>
        </div>
        <a class="btn-primary self-start" asp-page="Create">New product</a>
    </div>

    @if (Model.StatusMessage is not null)
    {
        <div class="mt-6 rounded-card border border-brand/30 bg-brand-light/60 px-4 py-3 text-sm text-brand-darker" role="status">
            @Model.StatusMessage
        </div>
    }

    @if (Model.Products.Count == 0)
    {
        <div class="card mt-8 text-center">
            <p class="text-slate-600">No products yet.</p>
            <a class="btn-primary mt-4 inline-flex" asp-page="Create">Create your first product</a>
        </div>
    }
    else
    {
        <div class="mt-8 flex flex-col gap-4">
            @foreach (var product in Model.Products)
            {
                <article class="card flex flex-col gap-4 lg:flex-row lg:items-center lg:justify-between">
                    <div class="min-w-0">
                        <div class="flex flex-wrap items-center gap-2">
                            <h2 class="text-lg font-bold text-slate-900">@product.Name</h2>
                            @if (product.Status == ProductStatus.Published)
                            {
                                <span class="inline-flex items-center rounded-full bg-emerald-100 px-2.5 py-0.5 text-xs font-semibold text-emerald-700">Published</span>
                            }
                            else
                            {
                                <span class="inline-flex items-center rounded-full bg-slate-200 px-2.5 py-0.5 text-xs font-semibold text-slate-600">Draft</span>
                            }
                        </div>
                        <div class="mt-1 flex flex-wrap items-center gap-x-3 gap-y-1 text-sm text-slate-600">
                            <span class="badge">@product.Category</span>
                            <span class="font-mono text-slate-400">/@product.Slug</span>
                            <span>
                                @switch (product.PricingKind)
                                {
                                    case PricingKind.Tiered:
                                        @($"Subscription · {product.PlanCount} {(product.PlanCount == 1 ? "tier" : "tiers")}")
                                        break;
                                    case PricingKind.Fixed:
                                        @($"Fixed price · {product.FixedPriceAmount:$#,##0.##} one-time")
                                        break;
                                    case PricingKind.Quote:
                                        @:Quote-based
                                        break;
                                }
                            </span>
                        </div>
                    </div>

                    <div class="flex flex-wrap items-center gap-2">
                        <a class="btn-secondary" asp-page="Edit" asp-route-id="@product.Id">Edit</a>
                        @if (product.Status == ProductStatus.Published)
                        {
                            <form method="post" asp-page-handler="Unpublish" asp-route-id="@product.Id">
                                <button type="submit" class="btn-ghost">Unpublish</button>
                            </form>
                        }
                        else
                        {
                            <form method="post" asp-page-handler="Publish" asp-route-id="@product.Id">
                                <button type="submit" class="btn-ghost">Publish</button>
                            </form>
                        }
                        <form method="post" asp-page-handler="Delete" asp-route-id="@product.Id"
                              onsubmit="return confirm('Delete &quot;@product.Name&quot;? This cannot be undone.');">
                            <button type="submit" class="btn-danger">Delete</button>
                        </form>
                    </div>
                </article>
            }
        </div>
    }
</section>
