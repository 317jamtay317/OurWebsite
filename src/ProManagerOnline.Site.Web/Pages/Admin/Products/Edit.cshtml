@page "{id:guid}"
@using ProManagerOnline.Site.Domain.Products
@model EditModel
@{
    var product = Model.Product;
    ViewData["Title"] = $"Edit {product.Name}";
    string Billing(BillingPeriod period) => period == BillingPeriod.Monthly ? "/mo" : "/yr";
}

<section class="container-site max-w-3xl py-10">
    <a class="text-sm font-medium text-brand hover:underline" asp-page="Index">&larr; Back to products</a>

    <div class="mt-2 flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">
        <div class="flex flex-wrap items-center gap-3">
            <h1 class="text-3xl font-bold tracking-tight text-slate-900">@product.Name</h1>
            @if (product.Status == ProductStatus.Published)
            {
                <span class="inline-flex items-center rounded-full bg-emerald-100 px-2.5 py-0.5 text-xs font-semibold text-emerald-700">Published</span>
            }
            else
            {
                <span class="inline-flex items-center rounded-full bg-slate-200 px-2.5 py-0.5 text-xs font-semibold text-slate-600">Draft</span>
            }
        </div>
        @if (product.Status == ProductStatus.Published)
        {
            <form method="post" asp-page-handler="Unpublish" asp-route-id="@product.Id">
                <button type="submit" class="btn-secondary">Unpublish</button>
            </form>
        }
        else
        {
            <form method="post" asp-page-handler="Publish" asp-route-id="@product.Id">
                <button type="submit" class="btn-primary">Publish</button>
            </form>
        }
    </div>

    @if (Model.StatusMessage is not null)
    {
        <div class="mt-6 rounded-card border border-brand/30 bg-brand-light/60 px-4 py-3 text-sm text-brand-darker" role="status">
            @Model.StatusMessage
        </div>
    }

    @* ---- Details ---- *@
    <form method="post" asp-page-handler="SaveDetails" asp-route-id="@product.Id" class="card mt-8 flex flex-col gap-5">
        <h2 class="text-xl font-bold text-slate-900">Details</h2>
        <div>
            <label class="label" asp-for="Details.Name">Name</label>
            <input class="input mt-1" asp-for="Details.Name" />
        </div>
        <div>
            <label class="label" asp-for="Details.Slug">Slug</label>
            @if (product.Status == ProductStatus.Published)
            {
                <input class="input mt-1 bg-slate-100 font-mono" asp-for="Details.Slug" readonly />
                <p class="mt-1 text-xs text-slate-500">Unpublish the product to change its slug.</p>
            }
            else
            {
                <input class="input mt-1 font-mono" asp-for="Details.Slug" />
            }
        </div>
        <div>
            <label class="label" asp-for="Details.Category">Category</label>
            <input class="input mt-1" asp-for="Details.Category" />
        </div>
        <div>
            <label class="label" asp-for="Details.Summary">Summary / description</label>
            <textarea class="input mt-1" asp-for="Details.Summary" rows="3"></textarea>
        </div>
        <div>
            <button type="submit" class="btn-primary">Save details</button>
        </div>
    </form>

    @* ---- Pricing ---- *@
    <form method="post" asp-page-handler="SetPricing" asp-route-id="@product.Id"
          data-has-plans="@product.Plans.Count" onsubmit="return confirmPricing(this);"
          class="card mt-6 flex flex-col gap-5">
        <h2 class="text-xl font-bold text-slate-900">Pricing</h2>
        <div class="flex flex-col gap-2">
            <label class="flex items-center gap-3 rounded-lg border border-slate-200 px-4 py-3 has-[:checked]:border-brand has-[:checked]:bg-brand-light/40">
                <input type="radio" asp-for="Pricing.Kind" value="Tiered" data-pricing />
                <span><span class="font-semibold text-slate-900">Subscription</span> &mdash; tiers (Basic, Pro, Enterprise)</span>
            </label>
            <label class="flex items-center gap-3 rounded-lg border border-slate-200 px-4 py-3 has-[:checked]:border-brand has-[:checked]:bg-brand-light/40">
                <input type="radio" asp-for="Pricing.Kind" value="Fixed" data-pricing />
                <span><span class="font-semibold text-slate-900">Fixed price</span> &mdash; a single one-time amount</span>
            </label>
            <label class="flex items-center gap-3 rounded-lg border border-slate-200 px-4 py-3 has-[:checked]:border-brand has-[:checked]:bg-brand-light/40">
                <input type="radio" asp-for="Pricing.Kind" value="Quote" data-pricing />
                <span><span class="font-semibold text-slate-900">Quote-based</span> &mdash; customers request a quote</span>
            </label>
        </div>
        <div data-pricing-panel="Fixed">
            <label class="label" asp-for="Pricing.FixedPriceAmount">One-time price (USD)</label>
            <input class="input mt-1" asp-for="Pricing.FixedPriceAmount" type="number" step="0.01" min="0" placeholder="499.00" />
        </div>
        <p class="text-xs text-slate-500">Switching away from subscription removes any tiers.</p>
        <div>
            <button type="submit" class="btn-primary">Save pricing</button>
        </div>
    </form>

    @* ---- Tiers / pricing detail ---- *@
    @if (product.PricingKind == PricingKind.Tiered)
    {
        <div class="mt-8">
            <h2 class="text-xl font-bold text-slate-900">Tiers</h2>
            @if (product.Plans.Count == 0)
            {
                <p class="mt-1 text-slate-600">No tiers yet. Add your first below.</p>
            }

            <div class="mt-4 flex flex-col gap-4">
                @foreach (var plan in product.Plans)
                {
                    <div class="card">
                        <div class="flex flex-col gap-3 sm:flex-row sm:items-start sm:justify-between">
                            <div>
                                <div class="flex flex-wrap items-center gap-2">
                                    <h3 class="text-lg font-bold text-slate-900">@plan.Name</h3>
                                    @if (plan.IsFeatured)
                                    {
                                        <span class="badge">Featured</span>
                                    }
                                </div>
                                <p class="mt-1 text-slate-600">
                                    <span class="font-semibold text-slate-900">@plan.Amount.ToString("$#,##0.##")</span><span class="text-slate-500">@Billing(plan.BillingPeriod)</span>
                                    @if (!string.IsNullOrWhiteSpace(plan.Description))
                                    {
                                        <span> &middot; @plan.Description</span>
                                    }
                                </p>
                            </div>
                            <div class="flex flex-wrap gap-2">
                                @if (!plan.IsFeatured)
                                {
                                    <form method="post" asp-page-handler="FeaturePlan" asp-route-id="@product.Id" asp-route-planId="@plan.Id">
                                        <button type="submit" class="btn-ghost">Make featured</button>
                                    </form>
                                }
                                <form method="post" asp-page-handler="RemovePlan" asp-route-id="@product.Id" asp-route-planId="@plan.Id"
                                      onsubmit="return confirm('Remove the &quot;@plan.Name&quot; tier?');">
                                    <button type="submit" class="btn-danger">Remove</button>
                                </form>
                            </div>
                        </div>

                        @if (plan.Features.Count > 0)
                        {
                            <ul class="mt-3 grid gap-1 sm:grid-cols-2">
                                @foreach (var feature in plan.Features)
                                {
                                    <li class="flex items-start gap-2 text-sm text-slate-700">
                                        <span class="mt-0.5 text-brand" aria-hidden="true">&check;</span>
                                        <span>@feature</span>
                                    </li>
                                }
                            </ul>
                        }

                        <details class="mt-4 border-t border-slate-100 pt-4">
                            <summary class="cursor-pointer text-sm font-semibold text-brand">Edit tier</summary>
                            <form method="post" asp-page-handler="UpdatePlan" asp-route-id="@product.Id" class="mt-3 flex flex-col gap-4">
                                <input type="hidden" name="EditPlan.PlanId" value="@plan.Id" />
                                <div class="grid gap-4 sm:grid-cols-2">
                                    <div>
                                        <label class="label">Name</label>
                                        <input class="input mt-1" name="EditPlan.Name" value="@plan.Name" />
                                    </div>
                                    <div>
                                        <label class="label">Description</label>
                                        <input class="input mt-1" name="EditPlan.Description" value="@plan.Description" />
                                    </div>
                                    <div>
                                        <label class="label">Price (USD)</label>
                                        <input class="input mt-1" name="EditPlan.Amount" type="number" step="0.01" min="0" value="@plan.Amount" />
                                    </div>
                                    <div>
                                        <label class="label">Billing</label>
                                        <select class="input mt-1" name="EditPlan.BillingPeriod">
                                            <option value="Monthly" selected="@(plan.BillingPeriod == BillingPeriod.Monthly)">Monthly</option>
                                            <option value="Annual" selected="@(plan.BillingPeriod == BillingPeriod.Annual)">Annual</option>
                                        </select>
                                    </div>
                                </div>
                                <div>
                                    <label class="label">Features (one per line)</label>
                                    <textarea class="input mt-1" name="EditPlan.FeaturesText" rows="4">@string.Join("\n", plan.Features)</textarea>
                                </div>
                                <div>
                                    <button type="submit" class="btn-primary">Save tier</button>
                                </div>
                            </form>
                        </details>
                    </div>
                }
            </div>

            @* ---- Add tier ---- *@
            <form method="post" asp-page-handler="AddPlan" asp-route-id="@product.Id" class="card mt-4 flex flex-col gap-4 border-dashed">
                <h3 class="text-lg font-bold text-slate-900">Add a tier</h3>
                <div class="grid gap-4 sm:grid-cols-2">
                    <div>
                        <label class="label" asp-for="NewPlan.Name">Name</label>
                        <input class="input mt-1" asp-for="NewPlan.Name" placeholder="Pro" />
                    </div>
                    <div>
                        <label class="label" asp-for="NewPlan.Description">Description</label>
                        <input class="input mt-1" asp-for="NewPlan.Description" placeholder="For growing teams." />
                    </div>
                    <div>
                        <label class="label" asp-for="NewPlan.Amount">Price (USD)</label>
                        <input class="input mt-1" asp-for="NewPlan.Amount" type="number" step="0.01" min="0" placeholder="79" />
                    </div>
                    <div>
                        <label class="label" asp-for="NewPlan.BillingPeriod">Billing</label>
                        <select class="input mt-1" asp-for="NewPlan.BillingPeriod" asp-items="Html.GetEnumSelectList<BillingPeriod>()"></select>
                    </div>
                </div>
                <div>
                    <label class="label" asp-for="NewPlan.FeaturesText">Features (one per line)</label>
                    <textarea class="input mt-1" asp-for="NewPlan.FeaturesText" rows="4" placeholder="Unlimited projects&#10;Priority support&#10;Advanced reports"></textarea>
                </div>
                <div>
                    <button type="submit" class="btn-primary">Add tier</button>
                </div>
            </form>
        </div>
    }
    else if (product.PricingKind == PricingKind.Fixed)
    {
        <div class="card mt-8">
            <h2 class="text-xl font-bold text-slate-900">Fixed price</h2>
            <p class="mt-2 text-slate-600">
                One-time price:
                <span class="font-semibold text-slate-900">@product.FixedPriceAmount?.ToString("$#,##0.##")</span>.
                Change the price in the Pricing section above, or switch to a subscription to add tiers.
            </p>
        </div>
    }
    else
    {
        <div class="card mt-8">
            <h2 class="text-xl font-bold text-slate-900">Quote-based</h2>
            <p class="mt-2 text-slate-600">Customers request a quote for this product. Switch to a subscription above to add tiers.</p>
        </div>
    }
</section>

@section Scripts {
    <script>
        function confirmPricing(form) {
            var selected = form.querySelector('[data-pricing]:checked');
            var hasPlans = parseInt(form.getAttribute('data-has-plans') || '0', 10) > 0;
            if (selected && selected.value !== 'Tiered' && hasPlans) {
                return confirm('Switching away from subscription will remove this product’s tiers. Continue?');
            }
            return true;
        }
        (function () {
            var radios = document.querySelectorAll('[data-pricing]');
            var panel = document.querySelector('[data-pricing-panel="Fixed"]');
            function sync() {
                var selected = document.querySelector('[data-pricing]:checked');
                if (panel) panel.style.display = (selected && selected.value === 'Fixed') ? '' : 'none';
            }
            radios.forEach(function (r) { r.addEventListener('change', sync); });
            sync();
        })();
    </script>
}
