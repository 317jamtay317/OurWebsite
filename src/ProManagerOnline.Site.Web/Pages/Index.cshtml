@page
@model IndexModel
@{
    ViewData["Title"] = "Home";
}

<section class="border-b border-slate-200 bg-gradient-to-b from-brand-light/60 to-white">
    <div class="container-site py-16 text-center">
        <span class="badge mb-4">Subscription software &amp; custom development</span>
        <h1 class="text-4xl font-bold tracking-tight text-slate-900 sm:text-5xl">
            Business software you can subscribe to today
        </h1>
        <p class="mx-auto mt-4 max-w-2xl text-lg text-slate-600">
            Software we build, host and maintain ourselves — billed as a straightforward
            subscription. No setup loans, no financing, just a monthly or annual plan.
        </p>
    </div>
</section>

<section class="container-site py-12">
    <div class="grid gap-6 md:grid-cols-2">
        @foreach (var product in Model.Products)
        {
            <article class="card flex flex-col">
                <span class="badge self-start">@product.Category</span>
                <h2 class="mt-3 text-2xl font-bold text-slate-900">@product.Name</h2>
                <p class="mt-2 flex-1 text-slate-600">@product.Summary</p>
                <div class="mt-5 flex flex-wrap gap-3">
                    <a class="btn-primary" href="/@product.Slug">Explore</a>
                    <a class="btn-secondary" href="/pricing">See pricing</a>
                </div>
            </article>
        }
    </div>
</section>
