@page "/admin/docs/new"
@page "/admin/docs/{id:guid}/edit"
@rendermode InteractiveAuto
@inject IDocsAdminApi Api
@inject NavigationManager Nav

<div class="mb-6 flex items-center justify-between gap-4">
    <h1 class="text-2xl font-bold tracking-tight text-slate-900">@(IsEditing ? "Edit article" : "New article")</h1>
    <a class="text-sm font-medium text-slate-500 hover:text-brand" href="/admin/docs">← Back to list</a>
</div>

@if (_loading)
{
    <p class="text-slate-500">Loading…</p>
}
else if (_loadError is not null)
{
    <div class="rounded-lg border border-red-200 bg-red-50 px-4 py-3 text-sm text-red-700">@_loadError</div>
}
else
{
    <div class="grid gap-8 lg:grid-cols-2">
        <div class="space-y-4">
            @if (_error is not null)
            {
                <div class="rounded-lg border border-red-200 bg-red-50 px-4 py-3 text-sm text-red-700">@_error</div>
            }
            @if (_saved)
            {
                <div class="rounded-lg border border-green-200 bg-green-50 px-4 py-3 text-sm text-green-700">Saved.</div>
            }

            <div>
                <label class="block text-sm font-medium text-slate-700" for="product">Product</label>
                <select id="product"
                        class="mt-1 w-full rounded-lg border border-slate-300 px-3 py-2 text-sm disabled:bg-slate-100 disabled:text-slate-500"
                        @bind="_productId" disabled="@IsEditing">
                    @foreach (var product in _products)
                    {
                        <option value="@product.Id">@product.Name</option>
                    }
                </select>
            </div>

            <div class="grid gap-4 sm:grid-cols-2">
                <div>
                    <label class="block text-sm font-medium text-slate-700" for="title">Title</label>
                    <input id="title" class="mt-1 w-full rounded-lg border border-slate-300 px-3 py-2 text-sm"
                           @bind="_title" @bind:event="oninput" />
                </div>
                <div>
                    <label class="block text-sm font-medium text-slate-700" for="section">Section</label>
                    <input id="section" class="mt-1 w-full rounded-lg border border-slate-300 px-3 py-2 text-sm"
                           @bind="_section" @bind:event="oninput" placeholder="Getting started" />
                </div>
            </div>

            <div class="grid gap-4 sm:grid-cols-2">
                <div>
                    <label class="block text-sm font-medium text-slate-700" for="slug">Slug</label>
                    <input id="slug"
                           class="mt-1 w-full rounded-lg border border-slate-300 px-3 py-2 text-sm disabled:bg-slate-100 disabled:text-slate-500"
                           @bind="_slug" disabled="@IsEditing" placeholder="getting-started" />
                    @if (IsEditing)
                    {
                        <p class="mt-1 text-xs text-slate-400">The slug can't change after creation.</p>
                    }
                </div>
                <div>
                    <label class="block text-sm font-medium text-slate-700" for="position">Position</label>
                    <input id="position" type="number" min="0"
                           class="mt-1 w-full rounded-lg border border-slate-300 px-3 py-2 text-sm" @bind="_position" />
                </div>
            </div>

            <div>
                <label class="block text-sm font-medium text-slate-700" for="body">Body (Markdown)</label>
                <textarea id="body" rows="14"
                          class="mt-1 w-full rounded-lg border border-slate-300 px-3 py-2 font-mono text-sm leading-6"
                          @bind="_body" @bind:event="oninput"></textarea>
            </div>

            <div>
                <span class="block text-sm font-medium text-slate-700">Screenshot</span>
                <div class="relative mt-1">
                    <InputFile OnChange="OnFileSelectedAsync" accept="image/*"
                               class="absolute inset-0 z-10 h-full w-full cursor-pointer opacity-0" />
                    <div class="flex flex-col items-center justify-center rounded-lg border-2 border-dashed border-slate-300 px-4 py-6 text-center text-sm text-slate-500">
                        @if (_uploading)
                        {
                            <span>Uploading…</span>
                        }
                        else
                        {
                            <span><span class="font-semibold text-brand">Choose an image</span> or drag &amp; drop</span>
                            <span class="mt-1 text-xs text-slate-400">It is added to the body and shown in the preview.</span>
                        }
                    </div>
                </div>
            </div>

            <div class="flex flex-wrap items-center gap-3 pt-2">
                <button type="button" class="btn-primary" @onclick="SaveAsync" disabled="@_saving">
                    @(_saving ? "Saving…" : "Save")
                </button>
                @if (IsEditing)
                {
                    @if (_published)
                    {
                        <button type="button" class="btn-secondary" @onclick="() => SetStatusAsync(false)" disabled="@_saving">Unpublish</button>
                    }
                    else
                    {
                        <button type="button" class="btn-secondary" @onclick="() => SetStatusAsync(true)" disabled="@_saving">Publish</button>
                    }
                    <span class="text-sm font-semibold @(_published ? "text-green-700" : "text-amber-700")">
                        @(_published ? "Published" : "Draft")
                    </span>
                }
            </div>
        </div>

        <div>
            <p class="text-sm font-semibold uppercase tracking-wide text-slate-500">Live preview</p>
            <div class="doc-content mt-2 rounded-card border border-slate-200 bg-white p-6 shadow-card">
                @Preview
            </div>
        </div>
    </div>
}

@code {
    /// <summary>The article's id when editing; <see langword="null"/> when creating a new article.</summary>
    [Parameter] public Guid? Id { get; set; }

    private static readonly Markdig.MarkdownPipeline Pipeline =
        new Markdig.MarkdownPipelineBuilder().UseAdvancedExtensions().Build();

    private IReadOnlyList<ProductOption> _products = [];
    private Guid _productId;
    private string _slug = "";
    private string _title = "";
    private string _section = "";
    private string _body = "";
    private int _position;
    private bool _published;

    private bool _loading = true;
    private string? _loadError;
    private string? _error;
    private bool _saved;
    private bool _saving;
    private bool _uploading;

    private bool IsEditing => Id.HasValue;

    private MarkupString Preview => new(Markdig.Markdown.ToHtml(
        string.IsNullOrWhiteSpace(_body) ? "*Nothing to preview yet.*" : _body, Pipeline));

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _products = await Api.GetPublishedProductsAsync();

            if (IsEditing)
            {
                var article = await Api.GetArticleAsync(Id!.Value);
                if (article is null)
                {
                    _loadError = "That article no longer exists.";
                    return;
                }

                _productId = article.ProductId;
                _slug = article.Slug;
                _title = article.Title;
                _section = article.Section;
                _body = article.Body;
                _position = article.Position;
                _published = article.Published;
            }
            else
            {
                _productId = QueryProductId() ?? (_products.Count > 0 ? _products[0].Id : Guid.Empty);
            }
        }
        catch (Exception ex)
        {
            _loadError = ex.Message;
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task SaveAsync()
    {
        _error = null;
        _saved = false;
        _saving = true;
        try
        {
            if (IsEditing)
            {
                await Api.UpdateArticleAsync(
                    Id!.Value, new UpdateDocArticleRequest(_title, _section, _body, _position));
                _saved = true;
            }
            else
            {
                var id = await Api.CreateArticleAsync(
                    new CreateDocArticleRequest(_productId, _slug, _title, _section, _body, _position));
                Nav.NavigateTo($"/admin/docs/{id}/edit");
            }
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _saving = false;
        }
    }

    private async Task SetStatusAsync(bool publish)
    {
        _error = null;
        _saving = true;
        try
        {
            await Api.SetArticleStatusAsync(Id!.Value, publish);
            _published = publish;
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _saving = false;
        }
    }

    private async Task OnFileSelectedAsync(InputFileChangeEventArgs e)
    {
        _error = null;
        var file = e.File;
        if (file is null)
        {
            return;
        }

        _uploading = true;
        try
        {
            await using var stream = file.OpenReadStream(maxAllowedSize: 10 * 1024 * 1024);
            var url = await Api.UploadScreenshotAsync(_productId, file.Name, stream);
            var separator = string.IsNullOrEmpty(_body) ? "" : "\n\n";
            _body += $"{separator}![{file.Name}]({url})\n";
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _uploading = false;
        }
    }

    private Guid? QueryProductId()
    {
        var query = new Uri(Nav.Uri).Query.TrimStart('?');
        foreach (var pair in query.Split('&', StringSplitOptions.RemoveEmptyEntries))
        {
            var parts = pair.Split('=', 2);
            if (parts.Length == 2
                && parts[0] == "productId"
                && Guid.TryParse(Uri.UnescapeDataString(parts[1]), out var id))
            {
                return id;
            }
        }

        return null;
    }
}
