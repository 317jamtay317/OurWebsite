@page "/admin/docs"
@rendermode InteractiveAuto
@inject IDocsAdminApi Api

<PageTitle>Documentation — ProManager Online Admin</PageTitle>

<div class="container-site py-10">
    <div class="mb-6 flex flex-wrap items-center justify-between gap-3">
        <div>
            <h1 class="text-2xl font-bold tracking-tight text-slate-900 sm:text-3xl">Documentation</h1>
            <p class="mt-1 text-slate-600">Create, edit and publish help articles for your products.</p>
        </div>
        <a class="btn-ghost" href="/admin">&larr; Dashboard</a>
    </div>

    @if (_error is not null)
    {
        <div class="mb-6 rounded-lg border border-red-200 bg-red-50 px-4 py-3 text-sm text-red-700" role="alert">@_error</div>
    }

    @if (_products is null)
    {
        <div class="card animate-pulse">
            <div class="h-4 w-40 rounded bg-slate-200"></div>
            <div class="mt-3 h-3 w-64 rounded bg-slate-100"></div>
        </div>
    }
    else if (_products.Count == 0)
    {
        <div class="card text-center">
            <h2 class="text-lg font-semibold text-slate-900">No published products yet</h2>
            <p class="mx-auto mt-2 max-w-md text-sm text-slate-600">
                Documentation attaches to a published product. Publish a product first, then come back to write its help articles.
            </p>
            <a class="btn-secondary mt-5" href="/admin/products">Manage products</a>
        </div>
    }
    else
    {
        <div class="card mb-6 flex flex-col gap-4 sm:flex-row sm:items-end sm:justify-between">
            <div class="w-full sm:w-72">
                <label class="label" for="product">Product</label>
                <select id="product" class="input" @bind="_selectedProductId" @bind:after="ReloadArticlesAsync">
                    @foreach (var product in _products)
                    {
                        <option value="@product.Id">@product.Name</option>
                    }
                </select>
            </div>
            <div class="flex flex-wrap items-center gap-3">
                <a class="btn-ghost" href="@PublicDocsHref" target="_blank" rel="noopener">Open public docs ↗</a>
                <a class="btn-primary" href="@NewArticleHref">+ New article</a>
            </div>
        </div>

        @if (_articles is null)
        {
            <div class="space-y-3">
                @for (var i = 0; i < 3; i++)
                {
                    <div class="card animate-pulse">
                        <div class="h-4 w-48 rounded bg-slate-200"></div>
                        <div class="mt-2 h-3 w-32 rounded bg-slate-100"></div>
                    </div>
                }
            </div>
        }
        else if (_articles.Count == 0)
        {
            <div class="card text-center">
                <h2 class="text-lg font-semibold text-slate-900">No articles yet</h2>
                <p class="mx-auto mt-2 max-w-md text-sm text-slate-600">
                    This product has no documentation. Create the first article to get started.
                </p>
                <a class="btn-primary mt-5" href="@NewArticleHref">+ New article</a>
            </div>
        }
        else
        {
            var groups = _articles.GroupBy(article => article.Section).ToList();

            <p class="mb-3 text-sm text-slate-500">
                @_articles.Count article@(_articles.Count == 1 ? "" : "s") in @groups.Count section@(groups.Count == 1 ? "" : "s")
            </p>

            <div class="space-y-6">
                @foreach (var group in groups)
                {
                    <section class="overflow-hidden rounded-card border border-slate-200 bg-white shadow-card">
                        <header class="flex items-center justify-between border-b border-slate-200 bg-slate-50 px-5 py-3">
                            <h2 class="font-semibold text-slate-900">@SectionLabel(group.Key)</h2>
                            <span class="text-xs font-medium text-slate-500">@group.Count() article@(group.Count() == 1 ? "" : "s")</span>
                        </header>
                        <ul class="divide-y divide-slate-100">
                            @foreach (var article in group)
                            {
                                <li class="flex flex-col gap-2 px-5 py-4 sm:flex-row sm:items-center sm:justify-between">
                                    <div class="min-w-0">
                                        <div class="flex flex-wrap items-center gap-2">
                                            <a class="font-semibold text-slate-900 hover:text-brand" href="@EditHref(article.Id)">@article.Title</a>
                                            @if (article.Published)
                                            {
                                                <span class="inline-flex items-center rounded-full bg-green-100 px-2.5 py-0.5 text-xs font-semibold text-green-800">Published</span>
                                            }
                                            else
                                            {
                                                <span class="inline-flex items-center rounded-full bg-amber-100 px-2.5 py-0.5 text-xs font-semibold text-amber-800">Draft</span>
                                            }
                                        </div>
                                        <p class="mt-1 truncate text-xs text-slate-400">
                                            #@article.Position · <code>@article.Slug</code>
                                        </p>
                                    </div>
                                    <div class="flex shrink-0 items-center gap-3">
                                        @if (article.Published)
                                        {
                                            <a class="text-sm font-medium text-slate-500 hover:text-brand"
                                               href="@PublicArticleHref(article.Slug)" target="_blank" rel="noopener">View ↗</a>
                                        }
                                        <a class="btn-secondary" href="@EditHref(article.Id)">Edit</a>
                                    </div>
                                </li>
                            }
                        </ul>
                    </section>
                }
            </div>
        }
    }
</div>

@code {
    private IReadOnlyList<ProductOption>? _products;
    private IReadOnlyList<DocArticleRow>? _articles;
    private Guid _selectedProductId;
    private string? _error;

    private string NewArticleHref => $"/admin/docs/new?productId={_selectedProductId}";

    private string PublicDocsHref => $"/docs/{_selectedProductId}";

    private string PublicArticleHref(string slug) => $"/docs/{_selectedProductId}/{slug}";

    private static string EditHref(Guid id) => $"/admin/docs/{id}/edit";

    private static string SectionLabel(string section) =>
        string.IsNullOrWhiteSpace(section) ? "General" : section;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _products = await Api.GetPublishedProductsAsync();
            if (_products.Count > 0)
            {
                _selectedProductId = _products[0].Id;
                await ReloadArticlesAsync();
            }
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
    }

    private async Task ReloadArticlesAsync()
    {
        _error = null;
        _articles = null;
        try
        {
            _articles = await Api.GetArticlesAsync(_selectedProductId);
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
    }
}
