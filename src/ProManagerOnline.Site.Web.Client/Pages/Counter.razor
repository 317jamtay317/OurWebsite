@page "/counter"
@rendermode InteractiveAuto

<PageTitle>Counter</PageTitle>

<section class="container-site py-10">
    <h1 class="text-2xl font-bold text-slate-900">Counter</h1>
    <p class="mt-2 text-slate-600" role="status">Current count: @currentCount</p>
    <button class="btn-primary mt-4" @onclick="IncrementCount">Click me</button>
</section>

@code {
    private int currentCount = 0;

    private void IncrementCount() => currentCount++;
}
