@page "/admin/about"
@rendermode InteractiveAuto
@inject IAboutPageAdminApi Api

<PageTitle>Edit About page — ProManager Online Admin</PageTitle>

<div class="container-site py-10">
    <div class="mb-6 flex flex-wrap items-center justify-between gap-3">
        <div>
            <nav class="text-sm text-slate-500" aria-label="Breadcrumb">
                <a class="hover:text-brand" href="/admin">Admin</a>
                <span class="px-1.5 text-slate-300" aria-hidden="true">/</span>
                <span class="text-slate-700">About page</span>
            </nav>
            <h1 class="mt-1 text-2xl font-bold tracking-tight text-slate-900 sm:text-3xl">Edit About page</h1>
        </div>
        <div class="flex items-center gap-3">
            <a class="text-sm font-medium text-brand hover:underline" href="/about" target="_blank" rel="noopener">View on site ↗</a>
            <a class="btn-ghost" href="/admin">&larr; Back to admin</a>
        </div>
    </div>

    @if (_loading)
    {
        <div class="card animate-pulse">
            <div class="h-4 w-40 rounded bg-slate-200"></div>
            <div class="mt-4 h-10 w-full rounded bg-slate-100"></div>
            <div class="mt-4 h-40 w-full rounded bg-slate-100"></div>
        </div>
    }
    else if (_loadError is not null)
    {
        <div class="card">
            <p class="text-slate-700">@_loadError</p>
            <a class="btn-secondary mt-5" href="/admin">&larr; Back to admin</a>
        </div>
    }
    else
    {
        <div class="grid items-start gap-8 lg:grid-cols-2">
            <div class="card space-y-5">
                @if (_error is not null)
                {
                    <div class="rounded-lg border border-red-200 bg-red-50 px-4 py-3 text-sm text-red-700" role="alert">@_error</div>
                }

                <div>
                    <label class="label" for="title">Heading</label>
                    <input id="title" class="input" @bind="Title" @bind:event="oninput" placeholder="About ProManager Online" />
                    <p class="mt-1 text-xs text-slate-400">Shown as the page's main heading.</p>
                </div>

                <div>
                    <label class="label" for="body">Body (Markdown)</label>
                    <textarea id="body" rows="18"
                              class="input resize-y font-mono text-sm leading-6"
                              @bind="Body" @bind:event="oninput" placeholder="Write your About page in Markdown…"></textarea>
                </div>

                <div class="flex flex-wrap items-center gap-3 border-t border-slate-200 pt-4">
                    <button type="button" class="btn-primary" @onclick="SaveAsync" disabled="@(!CanSave)">
                        @(_saving ? "Saving…" : "Save changes")
                    </button>
                    @if (_saved)
                    {
                        <span class="text-sm font-medium text-green-700">✓ Saved</span>
                    }
                    else if (!CanSave && !_saving)
                    {
                        <span class="text-xs text-slate-400">A heading and body are required.</span>
                    }
                </div>
            </div>

            <div class="lg:sticky lg:top-6">
                <p class="mb-2 text-sm font-semibold uppercase tracking-wide text-slate-500">Live preview</p>
                <div class="doc-content rounded-card border border-slate-200 bg-white p-6 shadow-card">
                    @if (!string.IsNullOrWhiteSpace(_title))
                    {
                        <h1>@_title</h1>
                    }
                    @Preview
                </div>
            </div>
        </div>
    }
</div>

@code {
    private static readonly Markdig.MarkdownPipeline Pipeline =
        new Markdig.MarkdownPipelineBuilder().UseAdvancedExtensions().Build();

    private string _title = "";
    private string _body = "";

    private bool _loading = true;
    private string? _loadError;
    private string? _error;
    private bool _saved;
    private bool _saving;

    // Editing any field clears the "Saved" confirmation so it only reflects a clean, persisted state.
    private string Title { get => _title; set { _title = value; _saved = false; } }
    private string Body { get => _body; set { _body = value; _saved = false; } }

    private bool CanSave =>
        !_saving
        && !string.IsNullOrWhiteSpace(_title)
        && !string.IsNullOrWhiteSpace(_body);

    private MarkupString Preview => new(Markdig.Markdown.ToHtml(
        string.IsNullOrWhiteSpace(_body) ? "*Nothing to preview yet.*" : _body, Pipeline));

    /// <summary>Loads the current About-page content into the form.</summary>
    protected override async Task OnInitializedAsync()
    {
        try
        {
            var content = await Api.GetAsync();
            if (content is not null)
            {
                _title = content.Title;
                _body = content.Body;
            }
        }
        catch (Exception ex)
        {
            _loadError = ex.Message;
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task SaveAsync()
    {
        _error = null;
        _saved = false;
        _saving = true;
        try
        {
            await Api.SaveAsync(new UpdateAboutPageRequest(_title, _body));
            _saved = true;
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _saving = false;
        }
    }
}
