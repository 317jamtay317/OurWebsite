@page "/admin/products"
@rendermode InteractiveAuto
@inject IProductAdminApi Api
@inject IJSRuntime JS

<PageTitle>Products admin — ProManager Online</PageTitle>

<section class="container-site py-10">
    <div class="flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">
        <div>
            <h1 class="text-3xl font-bold tracking-tight text-slate-900">Products</h1>
            <p class="mt-1 text-slate-600">Create and manage the products in your catalogue.</p>
        </div>
        <a class="btn-primary self-start" href="/admin/products/create">New product</a>
    </div>

    @if (_message is not null)
    {
        <div class="mt-6 rounded-card border border-brand/30 bg-brand-light/60 px-4 py-3 text-sm text-brand-darker" role="status">@_message</div>
    }

    @if (_products is null)
    {
        <p class="mt-8 text-slate-500">Loading…</p>
    }
    else if (_products.Count == 0)
    {
        <div class="card mt-8 text-center">
            <p class="text-slate-600">No products yet.</p>
            <a class="btn-primary mt-4 inline-flex" href="/admin/products/create">Create your first product</a>
        </div>
    }
    else
    {
        <div class="mt-8 flex flex-col gap-4">
            @foreach (var product in _products)
            {
                <article class="card flex flex-col gap-4 lg:flex-row lg:items-center lg:justify-between">
                    <div class="min-w-0">
                        <div class="flex flex-wrap items-center gap-2">
                            <h2 class="text-lg font-bold text-slate-900">@product.Name</h2>
                            @if (product.Status == ProductStatus.Published)
                            {
                                <span class="inline-flex items-center rounded-full bg-emerald-100 px-2.5 py-0.5 text-xs font-semibold text-emerald-700">Published</span>
                            }
                            else
                            {
                                <span class="inline-flex items-center rounded-full bg-slate-200 px-2.5 py-0.5 text-xs font-semibold text-slate-600">Draft</span>
                            }
                        </div>
                        <div class="mt-1 flex flex-wrap items-center gap-x-3 gap-y-1 text-sm text-slate-600">
                            <span class="badge">@product.Category</span>
                            <span class="font-mono text-slate-400">/@product.Slug</span>
                            <span>@ProductFormatting.PricingSummary(product)</span>
                        </div>
                    </div>

                    <div class="flex flex-wrap items-center gap-2">
                        <a class="btn-secondary" href="@($"/admin/products/edit/{product.Id}")">Edit</a>
                        @if (product.Status == ProductStatus.Published)
                        {
                            <button type="button" class="btn-ghost" disabled="@_busy" @onclick="() => Unpublish(product.Id)">Unpublish</button>
                        }
                        else
                        {
                            <button type="button" class="btn-ghost" disabled="@_busy" @onclick="() => Publish(product.Id)">Publish</button>
                        }
                        <button type="button" class="btn-danger" disabled="@_busy" @onclick="() => Delete(product)">Delete</button>
                    </div>
                </article>
            }
        </div>
    }
</section>

@code {
    private IReadOnlyList<ProductListItem>? _products;
    private string? _message;
    private bool _busy;

    protected override Task OnInitializedAsync() => LoadAsync();

    private async Task LoadAsync()
    {
        try
        {
            _products = await Api.ListAsync();
        }
        catch (ProductAdminException exception)
        {
            _message = exception.Message;
        }
    }

    private Task Publish(Guid id) => RunAsync(() => Api.PublishAsync(id), "Product published.");

    private Task Unpublish(Guid id) => RunAsync(() => Api.UnpublishAsync(id), "Product moved to draft.");

    private async Task Delete(ProductListItem product)
    {
        if (!await JS.InvokeAsync<bool>("confirm", $"Delete \"{product.Name}\"? This cannot be undone."))
        {
            return;
        }

        await RunAsync(() => Api.DeleteAsync(product.Id), "Product deleted.");
    }

    private async Task RunAsync(Func<Task> action, string success)
    {
        _busy = true;
        try
        {
            await action();
            _message = success;
            await LoadAsync();
        }
        catch (ProductAdminException exception)
        {
            _message = exception.Message;
        }
        finally
        {
            _busy = false;
        }
    }
}
