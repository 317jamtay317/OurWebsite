{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "pmo-dotnet",
      "runtimeExecutable": "dotnet",
      "runtimeArgs": ["run", "--project", "src/ProManagerOnline.Site.Web", "--launch-profile", "http"],
      "port": 5070
    },
    {
      "name": "pmo-docs-verify",
      "runtimeExecutable": "dotnet",
      "runtimeArgs": [
        "run",
        "--project",
        "src/ProManagerOnline.Site.Web",
        "--no-launch-profile",
        "--",
        "--urls=http://localhost:5071",
        "--environment=Development",
        "--ConnectionStrings:SiteDatabase=Server=(localdb)\\MSSQLLocalDB;Database=ProManagerOnlineSite_DocsVerify;Trusted_Connection=True;MultipleActiveResultSets=true"
      ],
      "port": 5071
    }
  ]
}
